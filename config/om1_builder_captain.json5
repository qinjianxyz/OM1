{
  version: "v1.0.3",
  api_key: "${OM_API_KEY:-openmind_free}",
  system_governance: "Do not harm humans. Do not invent event requirements. Help the builder create an OM1-native agent using the workshop primitives: modes, inputs, actions, backgrounds, lifecycle hooks, transition rules, WebSim, and MCP. Prefer local/offline operation when event credits or network access are constrained.",
  cortex_llm: {
    type: "OllamaLLM",
    config: {
      agent_name: "Forge",
      model: "qwen3.5:latest",
      base_url: "http://localhost:11434",
      temperature: 0.2,
      num_ctx: 4096,
      timeout: 120,
      history_length: 8,
    },
  },

  default_mode: "welcome",
  allow_manual_switching: true,
  mode_memory_enabled: true,

  modes: {
    welcome: {
      display_name: "Welcome",
      description: "Greets the judge and frames Forge as an OM1 builder-event agent.",
      system_prompt_base: "You are Forge, an OM1 robot build captain at the builder event. Greet the judge briefly. Explain that you can help turn an idea into a valid OM1 config and submission link. If the user asks what to build, how to use MCP, or how to submit, move toward workshop coach mode.",
      hertz: 0.5,
      agent_inputs: [
        {
          type: "MockInput",
          config: {
            input_name: "Manual Builder Prompt",
            port: 8787,
          },
        },
      ],
      simulators: [
        {
          type: "WebSim",
          config: {
            host: "0.0.0.0",
            port: 8000,
            tick_rate: 100,
            auto_reconnect: true,
            debug_mode: false,
          },
        },
      ],
      action_execution_mode: "concurrent",
      agent_actions: [
        {
          name: "speak",
          llm_label: "speak",
          connector: "zenoh",
          config: {
            speak_topic: "om1_builder/speech",
          },
        },
        {
          name: "face",
          llm_label: "emotion",
          connector: "avatar",
        },
      ],
      backgrounds: [
        {
          type: "OM1EventStatusBackground",
          config: {
            phase: "Welcome",
            interval_seconds: 3.0,
          },
        },
      ],
      lifecycle_hooks: [
        {
          hook_type: "on_startup",
          handler_type: "function",
          handler_config: {
            module_name: "om1_event_hook",
            function: "record_local_event_hook",
            phase: "Welcome startup",
          },
          priority: 1,
        },
      ],
    },

    workshop_coach: {
      display_name: "Workshop Coach",
      description: "Uses MCP tools to turn event intent into an OM1-native build plan.",
      system_prompt_base: "You are Forge in workshop coach mode. First use MCP tools to get the event schedule, recommend an OM1 agent blueprint, score readiness, and get a recovery plan. Then speak a concise plan with exactly four parts: concept, OM1 primitives used, robustness plan, and submission path. Keep it under 45 seconds.",
      save_interactions: true,
      hertz: 1,
      agent_inputs: [
        {
          type: "OM1EventCueInput",
          config: {
            cue_file: "hackathon/om1_event_cues.txt",
            input_name: "Builder Prompt",
            interval_seconds: 2.0,
            repeat: false,
          },
        },
        {
          type: "MockInput",
          config: {
            input_name: "Manual Builder Prompt",
            port: 8788,
          },
        },
        {
          type: "ConversationHistoryInput",
          config: {
            max_rounds: 3,
          },
        },
      ],
      simulators: [
        {
          type: "WebSim",
          config: {
            host: "0.0.0.0",
            port: 8000,
            tick_rate: 100,
            auto_reconnect: true,
            debug_mode: false,
          },
        },
      ],
      action_execution_mode: "sequential",
      agent_actions: [
        {
          name: "speak",
          llm_label: "speak",
          connector: "zenoh",
          config: {
            speak_topic: "om1_builder/speech",
          },
        },
        {
          name: "face",
          llm_label: "emotion",
          connector: "avatar",
        },
        {
          name: "submission_receipt",
          llm_label: "submission_receipt",
          connector: "local_file",
          config: {
            output_dir: "hackathon/receipts",
            filename: "om1_builder_submission_receipt.md",
          },
        },
      ],
      backgrounds: [
        {
          type: "OM1EventStatusBackground",
          config: {
            phase: "Workshop coach",
            interval_seconds: 3.0,
          },
        },
      ],
      mcp_servers: [
        {
          name: "event",
          transport: "stdio",
          command: "python3",
          args: ["hackathon/om1_event_mcp.py"],
        },
      ],
      lifecycle_hooks: [
        {
          hook_type: "on_entry",
          handler_type: "function",
          handler_config: {
            module_name: "om1_event_hook",
            function: "record_local_event_hook",
            phase: "Workshop coach entry",
          },
          priority: 1,
        },
      ],
    },

    readiness_review: {
      display_name: "Readiness Review",
      description: "Stress-tests the agent against judging criteria and no-credit live-demo failure modes.",
      system_prompt_base: "You are Forge in readiness review mode. Use MCP tools to score the submission and retrieve the failure recovery plan. Speak a tight judge-facing audit: one creative strength, one robustness strength, one live-demo fallback, and one final fix. Do not use paid cloud services; this mode is designed for local Ollama, MockInput, WebSim, local MCP, and local receipt writing.",
      save_interactions: true,
      hertz: 1,
      agent_inputs: [
        {
          type: "MockInput",
          config: {
            input_name: "Readiness Review Prompt",
            port: 8790,
          },
        },
        {
          type: "ConversationHistoryInput",
          config: {
            max_rounds: 4,
          },
        },
      ],
      simulators: [
        {
          type: "WebSim",
          config: {
            host: "0.0.0.0",
            port: 8000,
            tick_rate: 100,
            auto_reconnect: true,
            debug_mode: false,
          },
        },
      ],
      action_execution_mode: "sequential",
      agent_actions: [
        {
          name: "speak",
          llm_label: "speak",
          connector: "zenoh",
          config: {
            speak_topic: "om1_builder/speech",
          },
        },
        {
          name: "face",
          llm_label: "emotion",
          connector: "avatar",
        },
        {
          name: "submission_receipt",
          llm_label: "submission_receipt",
          connector: "local_file",
          config: {
            output_dir: "hackathon/receipts",
            filename: "om1_builder_submission_receipt.md",
          },
        },
      ],
      backgrounds: [
        {
          type: "OM1EventStatusBackground",
          config: {
            phase: "Readiness review",
            interval_seconds: 3.0,
          },
        },
      ],
      mcp_servers: [
        {
          name: "event",
          transport: "stdio",
          command: "python3",
          args: ["hackathon/om1_event_mcp.py"],
        },
      ],
      lifecycle_hooks: [
        {
          hook_type: "on_entry",
          handler_type: "function",
          handler_config: {
            module_name: "om1_event_hook",
            function: "record_local_event_hook",
            phase: "Readiness review entry",
          },
          priority: 1,
        },
      ],
    },

    submission_ready: {
      display_name: "Submission Ready",
      description: "Produces the final checklist, pitch, and local receipt.",
      system_prompt_base: "You are Forge in submission-ready mode. Use MCP tools for the checklist and pitch. Then write a submission_receipt action. Speak only the final config file path, no-credit demo command, and one-sentence pitch.",
      hertz: 1,
      agent_inputs: [
        {
          type: "MockInput",
          config: {
            input_name: "Manual Builder Prompt",
            port: 8789,
          },
        },
      ],
      simulators: [
        {
          type: "WebSim",
          config: {
            host: "0.0.0.0",
            port: 8000,
            tick_rate: 100,
            auto_reconnect: true,
            debug_mode: false,
          },
        },
      ],
      action_execution_mode: "sequential",
      agent_actions: [
        {
          name: "speak",
          llm_label: "speak",
          connector: "zenoh",
          config: {
            speak_topic: "om1_builder/speech",
          },
        },
        {
          name: "face",
          llm_label: "emotion",
          connector: "avatar",
        },
        {
          name: "submission_receipt",
          llm_label: "submission_receipt",
          connector: "local_file",
        },
      ],
      backgrounds: [
        {
          type: "OM1EventStatusBackground",
          config: {
            phase: "Submission ready",
            interval_seconds: 3.0,
          },
        },
      ],
      mcp_servers: [
        {
          name: "event",
          transport: "stdio",
          command: "python3",
          args: ["hackathon/om1_event_mcp.py"],
        },
      ],
      lifecycle_hooks: [
        {
          hook_type: "on_entry",
          handler_type: "function",
          handler_config: {
            module_name: "om1_event_hook",
            function: "record_local_event_hook",
            phase: "Submission ready entry",
          },
          priority: 1,
        },
      ],
    },
  },

  transition_rules: [
    {
      from_mode: "welcome",
      to_mode: "workshop_coach",
      transition_type: "input_triggered",
      trigger_keywords: [
        "what should I build",
        "build",
        "mcp",
        "agent",
        "project",
        "submission",
        "config file",
      ],
      priority: 5,
      cooldown_seconds: 1.0,
    },
    {
      from_mode: "workshop_coach",
      to_mode: "readiness_review",
      transition_type: "input_triggered",
      trigger_keywords: [
        "review",
        "robust",
        "score",
        "stress test",
        "judge",
        "no credit",
        "offline",
      ],
      priority: 7,
      cooldown_seconds: 2.0,
    },
    {
      from_mode: "readiness_review",
      to_mode: "submission_ready",
      transition_type: "input_triggered",
      trigger_keywords: [
        "ready to submit",
        "final checklist",
        "submit",
        "demo pitch",
      ],
      priority: 5,
      cooldown_seconds: 2.0,
    },
    {
      from_mode: "*",
      to_mode: "welcome",
      transition_type: "input_triggered",
      trigger_keywords: [
        "reset",
        "start over",
        "welcome mode",
      ],
      priority: 10,
      cooldown_seconds: 5.0,
    },
  ],
}
